+                            L.l1x1_b.data(), cond, _head_sum.data(), _layer_in.data(), kLeakySlope);
+      for (; f < num_frames; f++)
+        a2_neon8_tile<K, 1>(hist, tb, f, L.conv_w.data(), L.conv_b.data(), L.mixin_w.data(), L.l1x1_w.data(),
+                            L.l1x1_b.data(), cond, _head_sum.data(), _layer_in.data(), kLeakySlope);
+      return;
+    }
+  #endif
